# syntax=docker/dockerfile:1.7

# Debian's official Node image is multi-architecture. Building once per target
# platform makes native modules (notably node-hid) match the packaged Electron.
FROM node:22-bookworm AS build

ENV DEBIAN_FRONTEND=noninteractive \
    ELECTRON_CACHE=/root/.cache/electron \
    ELECTRON_BUILDER_CACHE=/root/.cache/electron-builder \
    CSC_IDENTITY_AUTO_DISCOVERY=false

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
      build-essential \
      ca-certificates \
      file \
      git \
      libasound2 \
      libatk-bridge2.0-0 \
      libatk1.0-0 \
      libcups2 \
      libdrm2 \
      libgbm1 \
      libgtk-3-0 \
      libnss3 \
      libopenjp2-tools \
      libudev-dev \
      libusb-1.0-0-dev \
      libx11-xcb1 \
      libxcomposite1 \
      libxdamage1 \
      libxrandr2 \
      libxss1 \
      python3 \
      xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare yarn@1.22.22 --activate

WORKDIR /project

COPY package.json yarn.lock ./
COPY scripts/update-electron-vendors.mjs scripts/update-electron-vendors.mjs
RUN --mount=type=cache,target=/usr/local/share/.cache/yarn \
    yarn install --frozen-lockfile --network-timeout 300000

COPY . .

RUN --mount=type=cache,target=/root/.cache/electron \
    --mount=type=cache,target=/root/.cache/electron-builder \
    yarn build \
    && yarn electron-builder --linux deb AppImage \
      --config .electron-builder.config.cjs \
      --publish never

RUN bash scripts/verify-linux-artifacts.sh dist

FROM scratch AS artifacts
COPY --from=build /project/dist/*.AppImage /
COPY --from=build /project/dist/*.deb /
